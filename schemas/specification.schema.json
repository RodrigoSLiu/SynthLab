{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Dataset Spec",
  "type": "object",
  "required": ["variables", "assumptions", "relationships", "validation"],
  "additionalProperties": false,

  "properties": {

    "variables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["continuous", "categorical", "binary"]
          }
        }
      }
    },

    "assumptions": {
      "type": "object",
      "required": ["marginals"],
      "additionalProperties": false,
      "properties": {

        "marginals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variable", "generator"],
            "additionalProperties": false,
            "properties": {

              "variable": {
                "type": "string"
              },

              "generator": {
                "type": "object",
                "required": ["name", "params"],
                "additionalProperties": false,
                "properties": {

                  "name": {
                    "type": "string",
                    "enum": [
                      "uniform",
                      "normal",
                      "exponential",
                      "binomial",
                      "beta",
                      "gamma",
                      "lognormal"
                    ]
                  },

                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "relationships": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["target", "inputs", "function"],
        "additionalProperties": false,
        "properties": {

          "target": {
            "type": "string"
          },

          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },

          "function": {
            "type": "object",
            "required": ["name", "params"],
            "additionalProperties": false,
            "properties": {

              "name": {
                "type": "string",
                "enum": [
                  "linear",
                  "polynomial",
                  "logistic",
                  "piecewise_linear"
                ]
              },

              "params": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },

          "noise": {
            "type": "object",
            "required": ["name", "params"],
            "additionalProperties": false,
            "properties": {

              "name": {
                "type": "string",
                "enum": ["normal"]
              },

              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },

    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {

          "type": {
            "type": "string",
            "enum": [
              "distribution",
              "slope",
              "polynomial",
              "classification"
            ]
          },

          "variable": { "type": "string" },

          "target": { "type": "string" },

          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },

          "test": {
            "type": "string",
            "enum": ["ks"]
          },

          "alpha": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },

          "expected": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "array",
                "items": { "type": "number" }
              }
            ]
          },

          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },

        "allOf": [

          {
            "if": { "properties": { "type": { "const": "distribution" } } },
            "then": {
              "required": ["variable", "test", "alpha"]
            }
          },

          {
            "if": { "properties": { "type": { "const": "slope" } } },
            "then": {
              "required": ["target", "inputs", "expected", "tolerance"]
            }
          },

          {
            "if": { "properties": { "type": { "const": "polynomial" } } },
            "then": {
              "required": ["target", "inputs", "expected", "tolerance"]
            }
          }

        ]
      }
    }
  }
}